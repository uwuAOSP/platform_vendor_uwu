prebuilt_media {
    name: "bootanimation_uwu",
    filename: "bootanimation.zip",
    product_specific: true,
    src: select(soong_config_variable("uwu_bootanimation", "resolution"), {
        "720": "expressive/bootanimation_720.zip",
        "1080": "expressive/bootanimation_1080.zip",
        "1440": "expressive/bootanimation_1440.zip",
        default: "expressive/bootanimation_1080.zip",
    }),
}
