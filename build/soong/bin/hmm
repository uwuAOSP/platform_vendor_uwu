function __print_uwu_functions_help() {
cat <<EOF
Additional uwuAOSP functions:
- brunch:          Runs "breakfast" and "m otapackage" for the provided device target.
- breakfast:       Selects a uwuAOSP lunch target.
- mmp:             Temporarily unavailable.
- mmmp:            Temporarily unavailable.
- mkap:            Temporarily unavailable.
- lineageremote:   Adds a Git remote for LineageOS Gerrit Review.
- aospremote:      Adds a Git remote for the matching AOSP repository.
- repopick:        Utility to fetch changes from Gerrit.
- sort-blobs-list: Sorts proprietary-files lists.
EOF
}
